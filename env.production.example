# NetOps MCP Production Environment Configuration
# Copy this file to .env and update with your values

# Server Configuration
HTTP_HOST=0.0.0.0
HTTP_PORT=8815
HTTP_PATH=/netops-mcp

# Configuration File Path
NETOPS_MCP_CONFIG=/app/config/config.json

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=/app/logs/netops-mcp.log

# Security Configuration (authentication & CORS)
# Authentication and CORS are NOT read from environment variables.
# They are configured in the JSON config file selected by NETOPS_MCP_CONFIG:
#   security.require_auth            (default: true — HTTP mode requires a key)
#   security.api_keys                (only 'sha256:<64-hex>' digests accepted)
#   security.enable_cors             (default: false)
#   security.cors_origins            (explicit origins only; wildcard '*' plus
#                                     credentials is rejected at config load)
#   security.cors_allow_credentials  (default: false)
# Generate a key and write its hash into the config:
#   python scripts/generate_api_key.py --hash --config config/config.json

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Allowed Hosts (comma-separated)
# Example: ALLOWED_HOSTS=example.com,api.example.com
ALLOWED_HOSTS=

# Network Configuration
DEFAULT_TIMEOUT=30
MAX_SCAN_TIMEOUT=300

# Docker-specific
PYTHONUNBUFFERED=1








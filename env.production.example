# NetOps MCP Production Environment Configuration
# Copy this file to .env and update with your values
#
# Only the variables listed under "Server Configuration" and "Runtime" below
# are actually read by the code or the startup script. Everything else that
# used to live here (logging, rate limiting, allowed hosts, timeouts, auth,
# CORS) is configured EXCLUSIVELY in the JSON config file selected by
# NETOPS_MCP_CONFIG — setting those as environment variables has no effect.

# Server Configuration
# Consumed by start_http_server.sh, which forwards them as --host/--port/--path
# CLI flags to `python -m netops_mcp.server_http`.
HTTP_HOST=0.0.0.0
HTTP_PORT=8815
HTTP_PATH=/netops-mcp

# Configuration File Path
# Read by server.py / server_http.py (falls back to this when --config is omitted).
NETOPS_MCP_CONFIG=/app/config/config.json

# Runtime
# Python line-buffering for container logs.
PYTHONUNBUFFERED=1

# ---------------------------------------------------------------------------
# The settings below are NOT environment variables. They live in the JSON
# config file (NETOPS_MCP_CONFIG). Listed here only so operators know where
# to set them — see config/config.example.json and README.md.
#
# Logging          -> logging.level, logging.format, logging.file
# Rate limiting     -> security.rate_limit_requests, security.rate_limit_window
# Allowed hosts     -> security.allowed_hosts
# Timeouts / scans  -> network.default_timeout, network.max_scan_timeout,
#                      network.allowed_ports
#
# Authentication & CORS (also JSON-only):
#   security.require_auth            (default: true — HTTP mode requires a key)
#   security.api_keys                (only 'sha256:<64-hex>' digests accepted)
#   security.enable_cors             (default: false)
#   security.cors_origins            (explicit origins only; wildcard '*' plus
#                                     credentials is rejected at config load)
#   security.cors_allow_credentials  (default: false)
# Generate a key and write its hash into the config:
#   python scripts/generate_api_key.py --hash --config config/config.json
# ---------------------------------------------------------------------------
